# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=5050
API_PREFIX=/api/v1
PUBLIC_WEB_BASE_URL=http://localhost:5173

# ── Database ────────────────────────────────────────────
# Local MongoDB (run `npm run mongo:up` to start the bundled Docker instance)
MONGO_URI=mongodb://127.0.0.1:27018/betnare?replicaSet=rs0&directConnection=true

# ── CORS ────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use * to allow all (dev only).
CORS_ORIGINS=*
CORS_CREDENTIALS=true

# ── Auth ────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Rate limiting ───────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ── Mamlaka payments ────────────────────────────────────
MAMLAKA_BASE_URL=https://payments.mam-laka.com
MAMLAKA_API_USERNAME=
MAMLAKA_API_PASSWORD=
MAMLAKA_MERCHANT_ID=
MAMLAKA_DISPLAY_NAME=ShilingiBet
MAMLAKA_CURRENCY=KES
MAMLAKA_DEFAULT_PROVIDER=M-Pesa
PUBLIC_CALLBACK_BASE_URL=http://localhost:5050
MAMLAKA_CALLBACK_BASE_URL=http://localhost:5050
MAMLAKA_CALLBACK_SECRET=

# ── Fusion bill-order deposits ──────────────────────────
FUSION_BASE_URL=https://sandbox.fusionfi.io/api/v1
FUSION_API_KEY=
FUSION_API_KEY_HEADER=x-api-key
FUSION_CURRENCY=KES
FUSION_CALLBACK_BASE_URL=http://localhost:5050
FUSION_CALLBACK_SECRET=
FUSION_ORDER_EXPIRY_MINUTES=1

# ── TransactPay card checkout ───────────────────────────
TRANSACTPAY_BASE_URL=https://payment-api-service.transactpay.ai
TRANSACTPAY_API_KEY=
TRANSACTPAY_ENCRYPTION_KEY=
TRANSACTPAY_DEFAULT_COUNTRY=US
TRANSACTPAY_CURRENCY=USD
TRANSACTPAY_REDIRECT_URL=http://localhost:5173

# ── Wallet limits ───────────────────────────────────────
DEPOSIT_MIN=1
DEPOSIT_MAX=250000
WITHDRAWAL_MIN=10
WITHDRAWAL_MAX=250000

# ── Referral rewards ────────────────────────────────────
REFERRAL_QUALIFYING_DEPOSIT_AMOUNT=100
REFERRAL_BONUS_AMOUNT=20

# ── EuroVirtuals / BetKraft ─────────────────────────────
EUROVIRTUALS_BASE_URL=https://api.staging.betkraft.co.uk
EUROVIRTUALS_API_KEY=
EUROVIRTUALS_APP_KEY=
EUROVIRTUALS_CURRENCY=KES
EUROVIRTUALS_RETURN_URL=http://localhost:5173
EUROVIRTUALS_VERIFY_CALLBACKS=true
EUROVIRTUALS_SESSION_TTL_HOURS=24

SMS_ENABLED=true
SMS_BASE_URL=https://isms.celcomafrica.com
SMS_PARTNER_ID=
SMS_API_KEY=
SMS_SHORTCODE=IMPALA LTD
SMS_PASS_TYPE=plain
SMS_PHPSESSID=
SMS_SENDER_NAME=IMPALA LTD
SMS_RESET_CODE_TTL_MINUTES=10
SMS_PHONE_VERIFICATION_TTL_MINUTES=10
MAMLAKA_CELO_BASE_URL=https://celo.mamlakapsp.com
MAMLAKA_CELO_API_KEY=
MAMLAKA_CELO_SECRET_KEY=
# MAMLAKA_CELO_USDC_KES_RATE is no longer used — the gateway's live
# /api/celo/quote endpoint is used instead so the rate can't drift.
